# --- API ---
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# MongoDB Atlas 연결 문자열 — Atlas 클러스터의 "Connect → Drivers"에서 복사한 뒤
# 데이터베이스 이름(psyche)을 경로에 추가해서 사용합니다. Atlas는 M0부터 이미 replica set이라
# 별도 설정이 필요 없습니다.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster-host>/psyche?appName=Cluster0"

REDIS_HOST=localhost
REDIS_PORT=6379
# 로컬 Docker Redis는 비밀번호가 없음 — Railway 등 매니지드 Redis는 값이 필요합니다.
REDIS_PASSWORD=

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 만든
# OAuth 2.0 클라이언트 ID(웹 애플리케이션). 클라이언트 시크릿은 필요 없다.
GOOGLE_CLIENT_ID=

# 특정 벤더에 종속되지 않음 — AI_PROVIDER 하나만 바꾸면 교체된다 (gemini | openai | groq)
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 로컬 디스크 기반 파일 스토리지 (7절 storage.interface.ts 구현체)
FILE_STORAGE_ROOT=./storage

# 개인용 도구 — 공개 회원가입 없음. 유일한 계정을 시드 스크립트(prisma/seed.ts)로 생성한다.
ADMIN_EMAIL=me@psyche.local
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Owner

# 일반 사용자가 리포트 생성을 연타해 AI 호출 비용이 새는 것을 막는 쿨다운(분). ADMIN 역할은 예외.
REPORT_CREATION_COOLDOWN_MINUTES=10

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# API와 동일한 Google OAuth 클라이언트 ID (공개값이라 프론트에 노출돼도 무방하다).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
